# Insights SIEM — environment template. Copy to .env and fill in.
# Database (P0 moved to PostgreSQL). Use postgresql://, not file:.
DATABASE_URL=postgresql://siem:CHANGE_ME@localhost:5432/siem?schema=public

# next-auth (REQUIRED for the auth middleware to work in production).
# Generate a strong secret:  openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Public base URL used by the capture agent when posting alerts.
# Capture agent posts to:  ${INGEST_BASE_URL}/api/alerts
INGEST_BASE_URL=http://localhost:3000
